{
  "name": "lirtup-ui",
  "private": true,
  "description": "Tailwind v4 build of lirtup-gui (dx does the same when it finds tailwind.css)",
  "scripts": {
    "tailwind:build": "tailwindcss -i ./tailwind.css -o ./assets/tailwind.css --minify",
    "tailwind:watch": "tailwindcss -i ./tailwind.css -o ./assets/tailwind.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "tailwindcss": "4.3.3"
  }
}
