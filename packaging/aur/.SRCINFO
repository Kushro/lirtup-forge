pkgbase = linux-rt-upscaler
	pkgdesc = LirtUp Forge: real-time SRCNN upscaler for X11 windows, with Magpie effects and frame generation
	pkgver = 2.0.1
	pkgrel = 1
	url = https://github.com/Kushro/lirtup-forge
	arch = x86_64
	license = GPL-3.0-or-later
	makedepends = cargo
	makedepends = dioxus-cli
	makedepends = git
	makedepends = npm
	makedepends = vulkan-headers
	depends = fontconfig
	depends = gcc-libs
	depends = glibc
	depends = gtk3
	depends = hicolor-icon-theme
	depends = libayatana-appindicator
	depends = libxcb
	depends = ttf-dejavu
	depends = vulkan-icd-loader
	depends = webkit2gtk-4.1
	depends = xdg-utils
	depends = xdotool
	optdepends = directx-shader-compiler: compile the MagpieFX effects (dxc, preferred)
	optdepends = glslang: compile the MagpieFX effects without dxc, and the 3 Anime4K Denoise effects
	optdepends = lsfg-vk: frame generation through the lsfg-vk Vulkan layer
	options = !lto
	source = linux-rt-upscaler::git+https://github.com/Kushro/lirtup-forge.git#tag=v2.0.1
	sha256sums = SKIP

pkgname = linux-rt-upscaler
